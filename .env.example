# Copy this file to .env and fill it in. Never share or commit the real .env.

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Your own Telegram user id – message the bot /start to find it
OWNER_TELEGRAM_ID=

# --- Claude (console.anthropic.com → API keys) ---
ANTHROPIC_API_KEY=

# --- Your business (printed on invoices) ---
BUSINESS_NAME=Performance Horse Therapy
OWNER_NAME=
# Use \n between address lines
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=hello@performancehorsetherapy.co.uk
BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
PAYMENT_TERMS_DAYS=14
DEFAULT_SESSION_MINUTES=60
TIMEZONE=Europe/London

# --- Twilio (text messages) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio UK number (+44...) or a sender name like PerfHorse (max 11 letters, clients can't reply)
TWILIO_FROM=

# --- Google (run scripts/google_login.py once) ---
# Either leave blank and keep data/google_token.json, or paste the token JSON here when hosting online
GOOGLE_TOKEN_JSON=

# --- Daily jobs (24h clock) ---
OVERDUE_CHECK_TIME=09:00
APPOINTMENT_REMINDER_TIME=18:00
APPOINTMENT_REMINDERS=on
REMINDER_GAP_DAYS=7
BACKUP_TIME=23:30
